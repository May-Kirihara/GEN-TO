{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GEN-TO Spike",
  "identifier": "dev.gento.spike",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GEN-TO 技術検証プロトタイプ",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": {
        "img-src": "'self' data: gento-thumb: gento-preview: gento-original:"
      },
      "devCsp": {
        "img-src": "'self' data: gento-thumb: gento-preview: gento-original:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
